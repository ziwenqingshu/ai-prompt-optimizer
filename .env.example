# run-local.sh automatically reads this file when copied to .env. Shell environment wins.
# Values are literal; do not use shell commands or variable expansion.
# mock allows local and Docker testing without an API key.
LLM_MODE=mock
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_JSON_MODE=true
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=60
APP_PORT=80
APP_BIND_ADDRESS=127.0.0.1
# Local history storage. Docker Compose maps this to the persistent /app/data volume.
APP_DATA_DIR=./data

# Local Ollama example (use a model already installed in Ollama):
# LLM_MODE=live
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=your-installed-model
# LLM_API_KEY=
# LLM_JSON_MODE=false
# Local LM Studio usually uses http://127.0.0.1:1234/v1.
# With Docker, loopback means the backend container, not the host machine.
